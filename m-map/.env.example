# Скопируйте в .env и заполните. Файл .env в git не попадает.

# ── Домен и TLS ──────────────────────────────────────────────
# На сервере: life.example.com. Пустой LETSENCRYPT_EMAIL — самоподписанный сертификат.
DOMAIN=localhost
LETSENCRYPT_EMAIL=
# LETSENCRYPT_STAGING=1
HTTP_PORT=80
HTTPS_PORT=443
APP_URL=https://localhost

# ── База ─────────────────────────────────────────────────────
# openssl rand -base64 24
POSTGRES_DB=mmap
POSTGRES_USER=mmap
POSTGRES_PASSWORD=change-me-long-random

# ── Доступ ───────────────────────────────────────────────────
# Регистрация закрыта; пользователь: docker compose exec web node scripts/user-create.mjs you@mail
ALLOW_SIGNUP=false
SESSION_DAYS=30
# false — только для http без TLS
COOKIE_SECURE=true
# Необязательно: Bearer-токен для /metrics
METRICS_TOKEN=

# ── LLM ──────────────────────────────────────────────────────
# bridge — мост к подписке Claude (docs/bridge.md); openrouter — по API.
LLM_PROVIDER=bridge
# Куда идти, если мост не ответил; пусто — без запасного.
LLM_FALLBACK=openrouter
# Мост на этом же сервере: http://host.docker.internal:8791 + NOA_BRIDGE_TOKEN,
# или через площадку NOAH: https://<noah>/api/noa/bridge + ключ noah_… владельца.
CLAUDE_BRIDGE_URL=
CLAUDE_BRIDGE_TOKEN=
# haiku | sonnet | opus
CLAUDE_BRIDGE_MODEL=sonnet
OPENROUTER_API_KEY=
# Например anthropic/claude-haiku-5.5
OPENROUTER_MODEL=
# AI-запросов в час на пользователя
AI_RATE_LIMIT=30

# ── Web Push (этап 5) ────────────────────────────────────────
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:you@example.com

# ── Бэкапы ───────────────────────────────────────────────────
BACKUP_DIR=./backups
BACKUP_KEEP_DAYS=14
BACKUP_CRON=15 3 * * *
