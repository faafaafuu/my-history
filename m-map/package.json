{
  "name": "m-map",
  "private": true,
  "packageManager": "pnpm@10.28.0",
  "engines": { "node": ">=22" },
  "scripts": {
    "dev": "pnpm --filter @m-map/web dev",
    "build": "pnpm -r build",
    "typecheck": "pnpm -r typecheck",
    "test": "pnpm -r test",
    "db:generate": "pnpm --filter @m-map/web db:generate",
    "db:migrate": "pnpm --filter @m-map/web db:migrate",
    "user:create": "pnpm --filter @m-map/web user:create"
  }
}
